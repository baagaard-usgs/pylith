#pragma once

#include "PetscJacobian.hh"

template<typename Dim>
inline
size_t
pylith::fekernels::common::PetscJacobian<Dim>::index3(const size_t f,
                                                      const size_t df,
                                                      const size_t g,
                                                      const size_t dg) {
    return Dim::value*Dim::value*Dim::value*f + Dim::value*Dim::value*g + Dim::value*df + dg;
}
