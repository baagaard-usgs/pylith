#pragma once

#include "Tensor2Field.hh"


template <typename Dim>
inline
pylith::scalar
pylith::fekernels::common::Tensor2Field<Dim>::operator()(size_t i,
                                                         size_t j) const {
    assert(value);
    return value[i*Dim::value+j];
}


template <typename Dim>
inline
pylith::scalar
pylith::fekernels::common::Tensor2Field<Dim>::dot(size_t i,
                                                  size_t j) const {
    assert(value_t);
    return value_t[i*Dim::value+j];
}
