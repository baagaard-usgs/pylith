#pragma once

#include "ScalarField.hh"

inline
pylith::scalar
pylith::fekernels::common::ScalarField::operator()() const {
    assert(value);
    return value[0];
}


inline
pylith::scalar
pylith::fekernels::common::ScalarField::dot(void) const {
    assert(value_t);
    return value_t[0];
}


inline
pylith::scalar
pylith::fekernels::common::ScalarField::gradient(size_t i) const {
    assert(grad);
    return grad[i];
}
