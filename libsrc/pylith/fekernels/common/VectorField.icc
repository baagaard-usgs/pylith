#pragma once

#include "VectorField.hh"


template <typename Dim>
inline
pylith::scalar
pylith::fekernels::common::VectorField<Dim>::operator()(size_t i) const {
    assert(value);
    return value[i];
}


template <typename Dim>
inline
pylith::scalar
pylith::fekernels::common::VectorField<Dim>::dot(size_t i) const {
    assert(value_t);
    return value_t[i];
}


template <typename Dim>
inline
pylith::scalar
pylith::fekernels::common::VectorField<Dim>::gradient(size_t i,
                                                      size_t j) const {
    assert(grad);
    return grad[i*Dim::value+j];
}
