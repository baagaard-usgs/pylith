#pragma once

#include "SolutionLayout.hh"

#include <cassert>


namespace pylith::fekernels::pde::elasticity {
    PYLITH_KERNEL constexpr SolutionFlags
    operator|(SolutionFlags a,
              SolutionFlags b) noexcept {
        return static_cast<SolutionFlags>(static_cast<size_t>(a) | static_cast<size_t>(b));
    } // operator|


    PYLITH_KERNEL constexpr SolutionFlags&
    operator|=(SolutionFlags& a,
               SolutionFlags b) noexcept {
        a = a | b;
        return a;
    }


    PYLITH_KERNEL constexpr bool
    operator&(SolutionFlags a,
              SolutionFlags b) noexcept {
        return static_cast<size_t>(a) & static_cast<size_t>(b);
    }


} // namespace pylith::fekernels::pde::elasticity


// Is a given flag present?
template<pylith::fekernels::pde::elasticity::SolutionFlags flags>
constexpr bool
pylith::fekernels::pde::elasticity::SolutionLayout<flags>::has(SolutionFlags f) noexcept {
    return (flags & f);
} // has


// Type-safe accessor — compile error if field not present
template<pylith::fekernels::pde::elasticity::SolutionFlags flags>
template<typename Dim>
template<pylith::fekernels::pde::elasticity::SolutionFlags F>
PYLITH_KERNEL const auto&
pylith::fekernels::pde::elasticity::SolutionLayout<flags>::Unpacked<Dim>::get() const noexcept requires(SolutionLayout<flags>::has(F)) {
    if constexpr (F == SolutionFlags::INERTIA) { return velocity.member;}
    if constexpr (F == SolutionFlags::FAULT) { return lagrange_multiplier_fault.member;}
} // get()


/// Unpack solution fields from array into struct with names.
template<pylith::fekernels::pde::elasticity::SolutionFlags flags>
template<typename Dim>
PYLITH_KERNEL auto
pylith::fekernels::pde::elasticity::SolutionLayout<flags>::unpack(const pylith::integer sOff[],
                                                                  const pylith::integer sOff_x[],
                                                                  const pylith::scalar s[],
                                                                  const pylith::scalar s_t[],
                                                                  const pylith::scalar s_x[]) -> Unpacked<Dim> {
    Unpacked<Dim> data;

    auto index = common::toIndex(Fields::DISPLACEMENT);
    data.displacement = {
        &s[sOff[index]],
        s_t ? &s_t[sOff[index]] : nullptr,
        s_x ? &s_x[sOff_x[index]] : nullptr,
    };

    if constexpr (has(SolutionFlags::INERTIA)) {
        index = common::toIndex(Fields::INERTIA);
        data.velocity = {
            &s[sOff[index]],
            s_t ? &s_t[sOff[index]] : nullptr,
            s_x ? &s_x[sOff_x[index]] : nullptr,
        };
    } // if

    if constexpr (has(SolutionFlags::FAULT)) {
        index = common::toIndex(Fields::LAGRANGE_MULTIPLIER_FAULT);
        data.lagrange_multiplier_fault = {
            &s[sOff[index]],
            s_t ? &s_t[sOff[index]] : nullptr,
            s_x ? &s_x[sOff_x[index]] : nullptr,
        };
    } // if

    return data;
} // unpack
