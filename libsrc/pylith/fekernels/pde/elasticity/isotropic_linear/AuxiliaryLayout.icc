#pragma once

#include "AuxiliaryLayout.hh"

#include <cassert>


namespace pylith::fekernels::pde::elasticity::isotropic_linear {
    PYLITH_KERNEL constexpr AuxiliaryFlags
    operator|(AuxiliaryFlags a,
              AuxiliaryFlags b) noexcept {
        return static_cast<AuxiliaryFlags>(static_cast<size_t>(a) | static_cast<size_t>(b));
    }


    PYLITH_KERNEL constexpr AuxiliaryFlags&
    operator|=(AuxiliaryFlags& a,
               AuxiliaryFlags b) noexcept {
        a = a | b;
        return a;
    }


    PYLITH_KERNEL constexpr bool
    operator&(AuxiliaryFlags a,
              AuxiliaryFlags b) noexcept {
        return static_cast<size_t>(a) & static_cast<size_t>(b);
    }


} // namespace pylith::fekernels::pde::elasticity::isotropic_linear


#define AUXILIARY_LAYOUT_TEMPLATE \
        template<pylith::fekernels::momentum::MomentumFlags mflags, \
                 pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryFlags flags>


// Is a given flag present?
AUXILIARY_LAYOUT_TEMPLATE
PYLITH_KERNEL constexpr bool
pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryLayout<mflags, flags>::has(MomentumFlags f) {
    return (mflags & f);
} // has


// Is a given flag present?
AUXILIARY_LAYOUT_TEMPLATE
PYLITH_KERNEL constexpr bool
pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryLayout<mflags, flags>::has(AuxiliaryFlags f) {
    return (flags & f);
} // has


// Type-safe accessor — compile error if field not present
AUXILIARY_LAYOUT_TEMPLATE
template <typename Dim>
template <pylith::fekernels::momentum::MomentumFlags F>
PYLITH_KERNEL auto&
pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryLayout<mflags, flags>::Unpacked<Dim>::get() const noexcept requires(Layout::has(F)) {
    if constexpr (F == MomentumFlags::BODY_FORCE) { return body_force.member;}
    if constexpr (F == MomentumFlags::GRAVITY) { return gravitational_acceleration.member;}
} // get()


AUXILIARY_LAYOUT_TEMPLATE
template <typename Dim>
template <pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryFlags F>
PYLITH_KERNEL const auto&
pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryLayout<mflags, flags>::Unpacked<Dim>::get() const noexcept requires(Layout::has(F)) {
    if constexpr (F == AuxiliaryFlags::REFERENCE_STRESS) { return reference_stress.member;}
    if constexpr (F == AuxiliaryFlags::REFERENCE_STRAIN) { return reference_strain.member;}
} // get()


/// Unpack solution fields from array into struct with names.
AUXILIARY_LAYOUT_TEMPLATE
template <typename Dim>
PYLITH_KERNEL auto
pylith::fekernels::pde::elasticity::isotropic_linear::AuxiliaryLayout<mflags, flags>::unpack(const pylith::integer aOff[],
                                                                                             const pylith::integer aOff_x[],
                                                                                             const pylith::scalar a[],
                                                                                             const pylith::scalar a_t[],
                                                                                             const pylith::scalar a_x[]) -> Unpacked<Dim> {
    Unpacked<Dim> data;

    data.density = {
        &a[aOff[common::toIndex(Fields::DENSITY)]],
        a_t ? &a_t[aOff[common::toIndex(Fields::DENSITY)]] : nullptr,
        a_x ? &a_x[aOff_x[common::toIndex(Fields::DENSITY)]] : nullptr,
    };

    data.bulk_modulus = {
        &a[aOff[common::toIndex(Fields::BULK_MODULUS)]],
        a_t ? &a_t[aOff[common::toIndex(Fields::BULK_MODULUS)]] : nullptr,
        a_x ? &a_x[aOff_x[common::toIndex(Fields::BULK_MODULUS)]] : nullptr,
    };

    data.shear_modulus = {
        &a[aOff[common::toIndex(Fields::SHEAR_MODULUS)]],
        a_t ? &a_t[aOff[common::toIndex(Fields::SHEAR_MODULUS)]] : nullptr,
        a_x ? &a_x[aOff_x[common::toIndex(Fields::SHEAR_MODULUS)]] : nullptr,
    };

    if constexpr (has(pylith::fekernels::momentum::MomentumFlags::BODY_FORCE)) {
        data.body_force = {
            &a[aOff[common::toIndex(Fields::BODY_FORCE)]],
            a_t ? &a_t[aOff[common::toIndex(Fields::BODY_FORCE)]] : nullptr,
            a_x ? &a_x[aOff_x[common::toIndex(Fields::BODY_FORCE)]] : nullptr,
        };
    }

    if constexpr (has(pylith::fekernels::momentum::MomentumFlags::GRAVITY)) {
        data.gravitational_acceleration = {
            &a[aOff[common::toIndex(Fields::GRAVITY)]],
            a_t ? &a_t[aOff[common::toIndex(Fields::GRAVITY)]] : nullptr,
            a_x ? &a_x[aOff_x[common::toIndex(Fields::GRAVITY)]] : nullptr,
        };
    }

    if constexpr (has(AuxiliaryFlags::REFERENCE_STRESS)) {
        data.reference_stress = {
            &a[aOff[common::toIndex(Fields::REFERENCE_STRESS)]],
            a_t ? &a_t[aOff[common::toIndex(Fields::REFERENCE_STRESS)]] : nullptr,
            a_x ? &a_x[aOff_x[common::toIndex(Fields::REFERENCE_STRESS)]] : nullptr,
        };
    }

    if constexpr (has(AuxiliaryFlags::REFERENCE_STRAIN)) {
        data.reference_strain = {
            &a[aOff[common::toIndex(Fields::REFERENCE_STRAIN)]],
            a_t ? &a_t[aOff[common::toIndex(Fields::REFERENCE_STRAIN)]] : nullptr,
            a_x ? &a_x[aOff_x[common::toIndex(Fields::REFERENCE_STRAIN)]] : nullptr,
        };
    }

    return data;
} // unpack


#undef AUXILIARY_LAYOUT_TEMPLATE
