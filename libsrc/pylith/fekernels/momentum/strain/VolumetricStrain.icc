#pragma once

#include "VolumetricStrain.hh"

/// ε_vol = tr(ε)
template<typename Dim, class SolutionLayout>
PYLITH_KERNEL pylith::scalar
pylith::fekernels::momentum::VolumetricStrain<Dim, SolutionLayout>::compute(const pylith::fekernels::common::Tensor2<Dim>& strain) {
    return strain.trace();
} // compute
